<T3DataStructure>
    <meta>
        <langDisable>1</langDisable>
        <langChildren>0</langChildren>
    </meta>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>LLL:EXT:cbgooglemaps/Resources/Private/Language/locallang.xlf:label.sheetLocation</sheetTitle>
                <type>array</type>
                <el>
                    <settings.cbgmIncludeJs>
                            <config>
                                <type>user</type>
                                <renderType>jsLibrariesElement</renderType>
                            </config>
                    </settings.cbgmIncludeJs>

                    <settings.cbgmStreet>
                            <label>LLL:EXT:cbgooglemaps/Resources/Private/Language/locallang.xlf:label.street</label>
                            <config>
                                <type>input</type>
                                <size>40</size>
                                <max>40</max>
                                <eval>trim</eval>
                            </config>
                    </settings.cbgmStreet>

                    <settings.cbgmZip>
                            <label>LLL:EXT:cbgooglemaps/Resources/Private/Language/locallang.xlf:label.zip</label>
                            <config>
                                <type>input</type>
                                <size>10</size>
                                <max>10</max>
                                <eval>trim</eval>
                            </config>
                    </settings.cbgmZip>

                    <settings.cbgmCity>
                            <label>LLL:EXT:cbgooglemaps/Resources/Private/Language/locallang.xlf:label.city</label>
                            <config>
                                <type>input</type>
                                <size>40</size>
                                <max>40</max>
                                <eval>trim</eval>
                            </config>
                    </settings.cbgmCity>

                    <settings.cbgmCountry>
                            <label>LLL:EXT:cbgooglemaps/Resources/Private/Language/locallang.xlf:label.country</label>
                            <config>
                                <type>input</type>
                                <size>40</size>
                                <max>60</max>
                                <eval>trim</eval>
                            </config>
                    </settings.cbgmCountry>

                    <cbgmButtonGeocoding>
                            <label></label>
                            <config>
                                <type>user</type>
                                <renderType>geoCodingButtonElement</renderType>
                            </config>
                    </cbgmButtonGeocoding>

                    <settings.cbgmLatitude>
                            <label>LLL:EXT:cbgooglemaps/Resources/Private/Language/locallang.xlf:label.latitude</label>
                            <config>
                                <type>input</type>
                                <size>25</size>
                                <max>25</max>
                                <eval>trim</eval>
                            </config>
                    </settings.cbgmLatitude>

                    <settings.cbgmLongitude>
                            <label>LLL:EXT:cbgooglemaps/Resources/Private/Language/locallang.xlf:label.longitude</label>
                            <config>
                                <type>input</type>
                                <size>25</size>
                                <max>25</max>
                                <eval>trim</eval>
                            </config>
                    </settings.cbgmLongitude>
                </el>
            </ROOT>
        </sDEF>

        <s_displayproperties>
            <ROOT>
                <sheetTitle>LLL:EXT:cbgooglemaps/Resources/Private/Language/locallang.xlf:label.sheetDisplay</sheetTitle>
                <type>array</type>
                <el>
                    <settings.cbgmDescription>
                            <label>LLL:EXT:cbgooglemaps/Resources/Private/Language/locallang.xlf:label.description</label>
                            <config>
                                <type>text</type>
                                <cols>50</cols>
                                <rows>10</rows>
                                <eval>trim</eval>
                            </config>
                    </settings.cbgmDescription>

                    <settings.cbgmAutoOpen>
                            <label>LLL:EXT:cbgooglemaps/Resources/Private/Language/locallang.xlf:label.autoOpen</label>
                            <config>
                                <type>check</type>
                                <default>0</default>
                            </config>
                    </settings.cbgmAutoOpen>

                    <settings.cbgmMapWidth>
                            <label>LLL:EXT:cbgooglemaps/Resources/Private/Language/locallang.xlf:label.mapWidth</label>
                            <config>
                                <type>input</type>
                                <size>4</size>
                                <max>5</max>
                                <eval>trim</eval>
                            </config>
                    </settings.cbgmMapWidth>

                    <settings.cbgmMapHeight>
                            <label>LLL:EXT:cbgooglemaps/Resources/Private/Language/locallang.xlf:label.mapHeight</label>
                            <config>
                                <type>input</type>
                                <size>4</size>
                                <max>5</max>
                                <eval>trim</eval>
                                <default>250</default>
                            </config>
                    </settings.cbgmMapHeight>

                    <settings.cbgmScaleLevel>
                            <label>LLL:EXT:cbgooglemaps/Resources/Private/Language/locallang.xlf:label.scaleLevel</label>
                            <config>
                                <type>input</type>
                                <size>3</size>
                                <eval>trim</eval>
                                <max>3</max>
                                <default>12</default>
                            </config>
                    </settings.cbgmScaleLevel>

                    <settings.cbgmMapType>
                            <label>LLL:EXT:cbgooglemaps/Resources/Private/Language/locallang.xlf:label.mapType</label>
                            <config>
                                <type>select</type>
                                <renderType>selectSingle</renderType>
                                <default>ROADMAP</default>
                                <items type="array">
                                    <numIndex index="0" type="array">
                                        <label></label>
                                        <value></value>
                                    </numIndex>
                                    <numIndex index="1" type="array">
                                        <label>LLL:EXT:cbgooglemaps/Resources/Private/Language/locallang.xlf:label.mapTypeRoadmap</label>
                                        <value>ROADMAP</value>
                                    </numIndex>
                                    <numIndex index="2" type="array">
                                        <label>LLL:EXT:cbgooglemaps/Resources/Private/Language/locallang.xlf:label.mapTypeSatellite</label>
                                        <value>SATELLITE</value>
                                    </numIndex>
                                    <numIndex index="3" type="array">
                                        <label>LLL:EXT:cbgooglemaps/Resources/Private/Language/locallang.xlf:label.mapTypeHybrid</label>
                                        <value>HYBRID</value>
                                    </numIndex>
                                    <numIndex index="4" type="array">
                                        <label>LLL:EXT:cbgooglemaps/Resources/Private/Language/locallang.xlf:label.mapTypeTerrain</label>
                                        <value>TERRAIN</value>
                                    </numIndex>
                                    <numIndex index="5" type="array">
                                        <label>LLL:EXT:cbgooglemaps/Resources/Private/Language/locallang.xlf:label.mapTypeMapbox.Basic</label>
                                        <value>MapBox-BASIC</value>
                                    </numIndex>
                                    <numIndex index="6" type="array">
                                        <label>LLL:EXT:cbgooglemaps/Resources/Private/Language/locallang.xlf:label.mapTypeMapbox.Streets</label>
                                        <value>MapBox-STREETS</value>
                                    </numIndex>
                                    <numIndex index="7" type="array">
                                        <label>LLL:EXT:cbgooglemaps/Resources/Private/Language/locallang.xlf:label.mapTypeMapbox.Bright</label>
                                        <value>MapBox-BRIGHT</value>
                                    </numIndex>
                                    <numIndex index="8" type="array">
                                        <label>LLL:EXT:cbgooglemaps/Resources/Private/Language/locallang.xlf:label.mapTypeMapbox.Light</label>
                                        <value>MapBox-LIGHT</value>
                                    </numIndex>
                                    <numIndex index="9" type="array">
                                        <label>LLL:EXT:cbgooglemaps/Resources/Private/Language/locallang.xlf:label.mapTypeMapbox.Dark</label>
                                        <value>MapBox-DARK</value>
                                    </numIndex>
                                    <numIndex index="10" type="array">
                                        <label>LLL:EXT:cbgooglemaps/Resources/Private/Language/locallang.xlf:label.mapTypeMapbox.Satellite</label>
                                        <value>MapBox-SATELLITE</value>
                                    </numIndex>
                                </items>
                            </config>
                    </settings.cbgmMapType>

                    <settings.cbgmNavigationControl>
                            <label>LLL:EXT:cbgooglemaps/Resources/Private/Language/locallang.xlf:label.navigationControl</label>
                            <config>
                                <type>select</type>
                                <renderType>selectSingle</renderType>
                                <default>DEFAULT</default>
                                <items type="array">
                                    <numIndex index="0" type="array">
                                        <label></label>
                                        <value></value>
                                    </numIndex>
                                    <numIndex index="1" type="array">
                                        <label>LLL:EXT:cbgooglemaps/Resources/Private/Language/locallang.xlf:label.navigationControlDefault</label>
                                        <value>DEFAULT</value>
                                    </numIndex>
                                    <numIndex index="2" type="array">
                                        <label>LLL:EXT:cbgooglemaps/Resources/Private/Language/locallang.xlf:label.navigationControlSmall</label>
                                        <value>SMALL</value>
                                    </numIndex>
                                    <numIndex index="3" type="array">
                                        <label>LLL:EXT:cbgooglemaps/Resources/Private/Language/locallang.xlf:label.navigationControlZoomPan</label>
                                        <value>ZOOM_PAN</value>
                                    </numIndex>
                                    <numIndex index="4" type="array">
                                        <label>LLL:EXT:cbgooglemaps/Resources/Private/Language/locallang.xlf:label.navigationControlAndroid</label>
                                        <value>ANDROID</value>
                                    </numIndex>
                                </items>
                            </config>
                    </settings.cbgmNavigationControl>

                    <cbgmButtonGeocoding>
                            <label></label>
                            <config>
                                <type>user</type>
                                <renderType>previewButtonElement</renderType>
                            </config>
                    </cbgmButtonGeocoding>
                </el>
            </ROOT>
        </s_displayproperties>
    </sheets>
</T3DataStructure>
